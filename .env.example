# Vercel Blob — powers the /gallery uploader and image listing.
#
# The gallery uses a PUBLIC Blob store (`jcc-gallery`) so images are
# served directly from Vercel's CDN. Connect the store to the project in
# the Vercel dashboard (or `vercel blob create-store <name> --access public`),
# then pull the injected token locally:
#   vercel env pull .env.local
#
# Provides (auto-injected in deployments; refreshed by env pull):
#   BLOB_READ_WRITE_TOKEN   # signs uploads + authorizes list(); store-scoped
BLOB_READ_WRITE_TOKEN=

# Shared secret that gates /gallery/upload. The upload route refuses to mint
# upload tokens unless the caller supplies this exact value (fails closed if
# unset). Set it in Vercel (all environments) and here for local dev:
#   vercel env add GALLERY_UPLOAD_PASSWORD
GALLERY_UPLOAD_PASSWORD=
