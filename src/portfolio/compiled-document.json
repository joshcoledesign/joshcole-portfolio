"<!doctype html>\r\n<html lang=\"en\" data-visualize-standalone data-portfolio-production=\"true\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<meta name=\"referrer\" content=\"no-referrer\">\r\n\r\n<title>__PAGE_TITLE__</title><meta name=\"description\" content=\"__PAGE_DESCRIPTION__\"><link rel=\"canonical\" href=\"__PAGE_URL__\"><meta property=\"og:title\" content=\"__PAGE_TITLE__\"><meta property=\"og:description\" content=\"__PAGE_DESCRIPTION__\"><meta property=\"og:url\" content=\"__PAGE_URL__\"><meta property=\"og:type\" content=\"website\"><meta property=\"og:image\" content=\"https://joshcolecreative.com/opengraph-image.png\"><meta name=\"twitter:card\" content=\"summary_large_image\"><link rel=\"icon\" href=\"/icon.png\"><meta name=\"theme-color\" content=\"#0b0d0c\">\r\n\r\n<link rel=\"stylesheet\" href=\"/portfolio/site-8510252872075a14.css\"><noscript><style>.rh-culture{display:none!important}.rh-culture-fallback{display:block!important}</style></noscript></head>\r\n<body>\r\n\r\n<div id=\"culture-case-studies\" aria-label=\"Culture homepage with case studies directly after the hero\">\r\n <select data-rh=\"face\" hidden aria-label=\"Typeface\"><option value=\"whyte\">Geist</option></select>\r\n <div class=\"rh-site\">\r\n <header class=\"rh-header\"><a href=\"/\" data-logo-home class=\"rh-identity cursor-interaction\" aria-label=\"Josh Cole — home\"><img class=\"rh-signature\" width=\"130\" height=\"72\" alt=\"Josh Cole signature\"></a><nav aria-label=\"Main navigation\"><a href=\"#rh-work\" class=\"cursor-interaction\">Case studies</a><a href=\"#rh-experiments\" class=\"cursor-interaction\">Experiments</a><a href=\"#rh-about\" class=\"cursor-interaction\">About</a></nav></header>\r\n <section id=\"rh-top\" class=\"rh-hero\" aria-label=\"Design, systems and experiments\"><canvas class=\"rh-culture\" width=\"1000\" height=\"667\" role=\"img\" aria-label=\"Living cellular culture: drifting bodies stretch, bud and separate. Choose Plant a seed to introduce new growth.\"></canvas><img class=\"rh-culture-fallback\" src=\"/portfolio/media/d9bcc3cc461d211ee1e9.webp\" alt=\"A captured Culture specimen\" hidden><label class=\"portfolio-ink\">Color<select data-rh=\"ink\" aria-label=\"Simulation color\"><option value=\"cyan\" selected>Cyan</option><option value=\"pink\">Pink</option><option value=\"acid\">Acid</option></select></label><div class=\"rh-hero-meta\"><span class=\"rh-eyebrow\">DESIGN / SYSTEMS / EXPERIMENTS</span><output class=\"rh-hero-fps\" data-stage-fps aria-label=\"Render rate\">— FPS</output>\r\n</div><div class=\"rh-hero-copy\"><h1>Systems, with<br>room for<br><em>surprise.</em></h1><p>I design the structure behind an experience—and leave room to discover what else it could become.</p><div class=\"rh-hero-links\"><a href=\"#rh-work\" class=\"cursor-interaction\">View case studies ↓</a><a href=\"#rh-experiments\" class=\"cursor-interaction\">Explore the experiments ↓</a></div></div><div class=\"rh-quick-culture\" aria-label=\"Culture experiment\">\r\n <div class=\"rh-quick-description\"><span class=\"rh-live-badge\" aria-hidden=\"true\">CULTURE / LIVE</span><label class=\"rh-quick-structure\">Cell structure<select data-live-control=\"structure\"><option value=\"colonies\">Colonies</option><option value=\"branching\">Branching</option><option value=\"labyrinth\">Labyrinth</option></select></label><a href=\"/experiments/culture\" data-open-experiment=\"culture\" class=\"cursor-interaction\">More controls &amp; how it works ↗</a></div>\r\n <div class=\"rh-quick-actions\"><button type=\"button\" data-live=\"run\" class=\"cursor-interaction\">Pause</button><button type=\"button\" data-live=\"plant\" aria-pressed=\"false\" class=\"cursor-interaction\">Plant a seed +</button><button type=\"button\" data-live=\"randomize\" class=\"cursor-interaction\">Randomize ↗</button></div>\r\n <span class=\"rh-quick-hint\" data-live-message role=\"status\" aria-live=\"polite\">Plant anywhere in the living field.</span>\r\n</div>\r\n</section>\r\n\r\n\r\n\r\n <section id=\"rh-work\" class=\"rh-work\" aria-labelledby=\"rh-case-studies-title\"><div class=\"rh-section-label\"><h2 id=\"rh-case-studies-title\">CASE STUDIES</h2><span>Clarity, at different scales.</span></div><div class=\"rh-work-list\">\r\n <a href=\"/work/gprs-sitemap\" data-open-case=\"gprs\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">01</span><span class=\"rh-work-name\">GPRS / SiteMap<small>A map-first platform across desktop, tablet and mobile.</small></span><span class=\"rh-category\">Enterprise / UX<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a>\r\n <a href=\"/work/einstein-bros-bagels\" data-open-case=\"einstein\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">02</span><span class=\"rh-work-name\">Einstein Bros. Bagels<small>Ordering, rewards and the store side.</small></span><span class=\"rh-category\">Mobile / Design systems<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a>\r\n <a href=\"/work/vrc-suite\" data-open-case=\"vrc\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">03</span><span class=\"rh-work-name\">VRC Suite<small>Four connected products. Decisions you can trace.</small></span><span class=\"rh-category\">Enterprise / UX leadership<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a>\r\n <a href=\"/work/novensia\" data-open-case=\"novensia\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">04</span><span class=\"rh-work-name\">Novensia<small>Brand Voice Engine + a brand operating system.</small></span><span class=\"rh-category\">AI systems / Brand<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a>\r\n<a href=\"/work/union-station-hotel\" data-open-case=\"union-station\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">05</span><span class=\"rh-work-name\">Union Station Hotel<small>A brand woven into the building.</small></span><span class=\"rh-category\">Brand / Hospitality<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/nemo-brand\" data-open-case=\"nemo\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">06</span><span class=\"rh-work-name\">NEMO<small>The inconsistency is the system.</small></span><span class=\"rh-category\">Brand / Art direction<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/ust-rfp-agent\" data-open-case=\"ust-rfp\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">07</span><span class=\"rh-work-name\">UST RFP Triage Agent<small>The first pass, so the team can decide.</small></span><span class=\"rh-category\">AI systems / Enterprise<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/andculture\" data-open-case=\"andculture\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">08</span><span class=\"rh-work-name\">Andculture<small>A rebrand that kept a hand in it.</small></span><span class=\"rh-category\">Brand / Print / Web<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/ouya\" data-open-case=\"ouya\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">09</span><span class=\"rh-work-name\">OUYA<small>A console launch, E3 and an international store.</small></span><span class=\"rh-category\">Brand / Web / Commerce<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/willow\" data-open-case=\"willow\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">10</span><span class=\"rh-work-name\">Willow<small>A mattress brand grown from a tree.</small></span><span class=\"rh-category\">Brand / Packaging<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a><a href=\"/work/emergence\" data-open-case=\"emergence\" class=\"rh-case-link cursor-interaction\"><span class=\"rh-number\">11</span><span class=\"rh-work-name\">Emergence<small>The design system behind Novensia.</small></span><span class=\"rh-category\">Design systems<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></a> </div></section>\r\n <section id=\"rh-experiments\" class=\"rh-open-experiments\" aria-labelledby=\"rh-experiments-title\"><div class=\"rh-experiments-intro\"><h2 id=\"rh-experiments-title\">Open <span>experiments.</span></h2><span class=\"rh-experiments-arrow\" aria-hidden=\"true\">↘</span></div>\r\n <section class=\"rh-dungeon\" aria-labelledby=\"rh-dungeon-title\"><div class=\"rh-dungeon-copy\"><span class=\"rh-eyebrow\">OPEN EXPERIMENT / DRY RUN DUNGEON</span><h2 id=\"rh-dungeon-title\">Learn the world.<br>Imagine a move.<br><em>Then act.</em></h2><p>A browser-based experiment in planning with a learned world model.</p><a href=\"/experiments/dry-run-dungeon\" data-open-experiment=\"dungeon\" class=\"rh-dungeon-link cursor-interaction\">Inside Dry Run Dungeon ↗</a></div><figure class=\"rh-dungeon-visual\"><div class=\"rh-capture\"><img src=\"/portfolio/media/9565f81197c3a9064948.webp\" width=\"1200\" height=\"1480\" alt=\"Actual Dry Run Dungeon interface: cyan ground-truth game grid and violet model view\"></div><figcaption>Actual application capture / seed 1<br>Game simulation · learned model</figcaption><details class=\"rh-full-capture\"><summary class=\"cursor-interaction\">View the full interface +</summary><img data-dungeon-full width=\"1200\" height=\"1480\" alt=\"Full actual Dungeon interface, including controls, prediction errors and run statistics\"></details></figure><details id=\"rh-dungeon-method\" class=\"rh-dungeon-method\" open><summary class=\"cursor-interaction\">Inside the experiment</summary><p>The world model is an ensemble of three small neural networks trained from play. Given a state and an action, it predicts the next state, reward and whether the run ends.</p><p>The planner evaluates candidate action sequences through that learned model, commits one move to the game simulation, then plans again. Side-by-side views expose the difference between predicted outcomes and actual transitions.</p><div class=\"rh-method-row\"><span>Learned predictor</span><span>Planning in imagination</span><span>Visible prediction error</span></div></details></section>\r\n <section class=\"rh-lab\" aria-labelledby=\"rh-lab-title\"><div class=\"rh-section-label\"><h2 id=\"rh-lab-title\">MORE EXPERIMENTS</h2></div><a class=\"gs-home-feature cursor-interaction\" href=\"/experiments/gensound\" data-open-experiment=\"gensound\"><div><span class=\"rh-eyebrow\">OPEN EXPERIMENT / GENSOUND</span><h3>A song.<br><em>All at once.</em></h3><p>Turn sound into color. Change the rules. Compare two ways of seeing the same track.</p><span class=\"gs-home-cta\">Enter the color lab ↗</span></div><figure><img src=\"/portfolio/case-assets/gensound-preview.webp\" width=\"934\" height=\"459\" alt=\"Actual GenSound rings and Hilbert outputs from the Chopin example\" loading=\"lazy\"><figcaption>RINGS + HILBERT / AUDIO → COLOR</figcaption></figure></a><div class=\"rh-experiment-strip\" aria-label=\"Featured open experiments\"><a href=\"/experiments/culture\" data-open-experiment=\"culture\" class=\"cursor-interaction\"><img data-culture-thumbnail alt=\"Culture specimen\"><span>01 / Culture<small>Controls &amp; how it works ↗</small></span></a><a href=\"/experiments/hype\" class=\"cursor-interaction\"><img src=\"/portfolio/open-projects/hype-field-preview.webp\" width=\"640\" height=\"360\" alt=\"Live Hype composition made from hand-drawn fragments\" loading=\"lazy\"><span>02 / Hype<small>Illustration + generative code ↗</small></span></a><a href=\"/experiments/worldstage\" class=\"cursor-interaction\"><img src=\"/portfolio/open-projects/worldstage-preview.webp\" width=\"640\" height=\"360\" alt=\"Actual Worldstage landing study on a volcanic shore\" loading=\"lazy\"><span>03 / Worldstage<small>Directing simulated performances ↗</small></span></a><a href=\"/experiments/premise\" class=\"cursor-interaction\"><img src=\"/portfolio/open-projects/premise-preview.webp\" width=\"640\" height=\"360\" alt=\"The Last Light, a generated Premise world\" loading=\"lazy\"><span>04 / Premise<small>From a sentence to a world ↗</small></span></a></div><details class=\"rh-secondary-experiments\"><summary class=\"cursor-interaction\">More generative studies</summary><div><a href=\"/experiments/field-conditions\" data-open-experiment=\"field\">Field conditions ↗</a><a href=\"/experiments/type-in-motion\" data-open-experiment=\"type\">Type, in motion ↗</a><a href=\"/experiments/grid-pressure\" data-open-experiment=\"grid\">Grid pressure ↗</a></div></details><p class=\"rh-experiment-note\" role=\"status\" hidden></p></section>\r\n </section>\r\n <footer id=\"rh-about\" class=\"rh-footer\"><div><span class=\"rh-eyebrow\">JOSH COLE / INDEPENDENT PRACTICE</span><p>Enterprise rigor.<br>Room to wander.</p></div><nav class=\"portfolio-site-links\" aria-label=\"More from Josh Cole\"><a href=\"/archive\">All work ↗</a><a href=\"/work/photography\">Photography ↗</a><a href=\"/about\">About ↗</a><a href=\"/resume\" target=\"_blank\" rel=\"noopener noreferrer\">Résumé ↗</a><a href=\"/portfolio/licenses/index.html\">Open-source notices ↗</a><button type=\"button\" data-contact-reveal>Contact ↗</button></nav><span class=\"rh-footer-note\">Design systems.<br>AI systems.<br>Experimental work.</span></footer>\r\n </div>\r\n <section class=\"rd-shell\" hidden aria-label=\"Experiment detail\">\r\n  <header class=\"rd-header\"><a href=\"/#experiments\" data-return-home class=\"cursor-interaction\">← All experiments</a><a href=\"/\" data-logo-home class=\"rd-home cursor-interaction\" aria-label=\"Josh Cole — portfolio\"><img class=\"rh-signature\" width=\"95\" height=\"53\" alt=\"Josh Cole signature\"></a><span class=\"rd-edition\">INDEPENDENT EXPERIMENTS</span></header>\r\n  <main class=\"rd-view rd-culture\" data-detail=\"culture\" hidden>\r\n   <div class=\"rd-culture-title\"><span class=\"rh-eyebrow\">001 / LIVING SYSTEMS</span><h1>Culture<span class=\"rd-live-dot\" aria-hidden=\"true\"></span></h1><p>Living matter, imagined.</p><span class=\"rd-margin-note\">BUD / STRETCH / RELEASE</span></div>\r\n   <div class=\"rd-culture-stage\" aria-label=\"Culture specimen\"><output class=\"rd-stage-fps\" data-stage-fps aria-label=\"Live render rate\">— FPS</output><span class=\"rd-specimen-label\">LIVE MATERIAL / 64 SIMULATION UNITS</span></div>\r\n   <div data-culture-controller> <section id=\"rh-culture-controls\" class=\"rh-specimen\" aria-label=\"Culture live controls, simulation state and method\">\r\n  <div class=\"rh-specimen-lead\">\r\n   <span class=\"rh-eyebrow\">CULTURE / LIVE GENERATIVE STUDY</span>\r\n   <p>A living simulation.<br>Plant a seed. Watch it evolve.</p>\r\n   <div class=\"rh-culture-actions\"><button type=\"button\" data-live=\"run\" class=\"cursor-interaction\">Pause</button><button type=\"button\" data-live=\"plant\" aria-pressed=\"false\" class=\"cursor-interaction\">Plant a seed +</button><button type=\"button\" data-live=\"randomize\" class=\"cursor-interaction\">Randomize ↗</button></div>\r\n   <span class=\"rh-placement\" data-live-message role=\"status\" aria-live=\"polite\">Evolving above. Plant anywhere in the living field.</span>\r\n   <div class=\"rh-seed-controls\"><label>Seed<input type=\"number\" min=\"0\" max=\"99999\" step=\"1\" value=\"45838\" data-live-seed></label><button type=\"button\" data-live=\"repeat\" class=\"cursor-interaction\">Repeat seed ↻</button></div>\r\n  </div>\r\n  <div class=\"rh-instrument\">\r\n   <span class=\"rh-eyebrow\">SIMULATION STATE</span>\r\n   <dl><div><dt>state</dt><dd data-live-state>evolving / live</dd></div><div><dt>seed</dt><dd data-live-seed-value>45838</dd></div><div><dt>iteration</dt><dd data-live-iteration>600</dd></div><div><dt>growth</dt><dd data-live-model>cell budding + separation</dd></div><div><dt>render</dt><dd data-live-fps>— FPS</dd></div></dl>\r\n   <div class=\"rh-culture-choices\" aria-label=\"Culture cell structures\">\r\n <label>Cell structure<select data-live-control=\"structure\"><option value=\"colonies\">Colonies</option><option value=\"branching\">Branching</option><option value=\"labyrinth\">Labyrinth</option></select></label>\r\n <label>Growth speed <output data-live-speed>2×</output><input type=\"range\" min=\"0\" max=\"2\" step=\"0.25\" value=\"2\" data-live-control=\"speed\" aria-label=\"Growth speed\"></label>\r\n</div>\r\n\r\n  </div>\r\n  <div class=\"rh-visible-method\" aria-labelledby=\"rh-method-heading\">\r\n   <div class=\"rh-method-heading\"><div><span class=\"rh-eyebrow\">INSIDE THE EXPERIMENT</span><h2 id=\"rh-method-heading\">How Culture works</h2></div><a href=\"/experiments/culture\" data-open-experiment=\"culture\" class=\"cursor-interaction rh-detail-link\">Enter the Culture study ↗</a></div>\r\n   <p data-method-intro>Rounded bodies follow changing currents, grow daughter cells and pull apart through soft, narrowing connections.</p>\r\n   <ol class=\"rh-method-steps\"><li><h3 data-method-title=\"0\">Drift</h3><p data-method-copy=\"0\">Each cellular family follows its own path through the moving field.</p></li><li><h3 data-method-title=\"1\">Stretch</h3><p data-method-copy=\"1\">A daughter grows away from its parent. The connecting neck stretches, thins and releases.</p></li><li><h3 data-method-title=\"2\">Renew</h3><p data-method-copy=\"2\">New buds form on independent cycles, keeping the culture in motion.</p></li></ol>\r\n   <p class=\"rh-method-footnote\">An authored, microscopy-inspired system. Planting introduces new growth; the seed lets you revisit its starting conditions.</p>\r\n  </div>\r\n </section></div>\r\n  </main>\r\n  <main class=\"rd-view rd-field\" data-detail=\"field\" hidden>\r\n   <div class=\"rd-field-heading\"><span class=\"rh-eyebrow\">002 / FORCE + FLOW</span><h1>Field<br><em>conditions.</em></h1><p>Direction emerges<br>from local forces.</p></div>\r\n   <figure class=\"rd-field-figure\"><canvas data-detail-field role=\"img\" aria-label=\"A field of short directional lines curving around a shared center\"></canvas><figcaption><span>VECTOR STUDY</span><span data-field-seed>SEED 31</span></figcaption></figure>\r\n   <div class=\"rd-study-controls\"><button type=\"button\" data-reseed-field class=\"cursor-interaction\">Reseed the field ↗</button><span>Small marks. A larger current.</span></div>\r\n   <section class=\"rd-method\"><span class=\"rh-eyebrow\">INSIDE THE EXPERIMENT</span><h2>How the field takes shape</h2><p>A seed places short line segments across the surface. Each line turns in response to its position around a shared center. Together, the local directions reveal a larger flow.</p><div class=\"rd-method-sequence\"><span>Place the marks</span><span>Calculate direction</span><span>Reveal the current</span></div></section>\r\n  </main>\r\n  <main class=\"rd-view rd-type\" data-detail=\"type\" hidden>\r\n   <div class=\"rd-type-heading\"><span class=\"rh-eyebrow\">003 / PROPORTION + RHYTHM</span><h1>Type,<br>in motion.</h1><p>A letter becomes a material.</p></div>\r\n   <div class=\"rd-type-specimen\" aria-label=\"Adjustable typographic specimen\"><span class=\"rd-type-glyph\" aria-hidden=\"true\">Aa</span><span class=\"rd-type-caption\">FORM / COUNTERFORM</span></div>\r\n   <div class=\"rd-type-controls rd-study-controls\"><label>Width <output data-type-width>100%</output><input type=\"range\" min=\"65\" max=\"140\" step=\"1\" value=\"100\" data-type-control=\"width\" aria-label=\"Specimen width\"></label><label>Angle <output data-type-angle>−8°</output><input type=\"range\" min=\"-18\" max=\"18\" step=\"1\" value=\"-8\" data-type-control=\"angle\" aria-label=\"Specimen angle\"></label></div>\r\n   <section class=\"rd-method\"><span class=\"rh-eyebrow\">INSIDE THE EXPERIMENT</span><h2>How proportion changes a voice</h2><p>Width and angle alter the relationship between a letter’s body and the space inside it. Move either control to explore how the same forms feel compressed, open or off balance.</p><p>The study transforms the drawn forms; it does not change the font’s underlying outlines.</p></section>\r\n  </main>\r\n  <main class=\"rd-view rd-grid\" data-detail=\"grid\" hidden>\r\n   <div class=\"rd-grid-heading\"><span class=\"rh-eyebrow\">004 / ORDER + INTERFERENCE</span><h1>Grid<br>pressure<span>↙</span></h1><p>A regular system.<br>A localized disturbance.</p></div>\r\n   <figure class=\"rd-grid-figure\"><div class=\"rd-grid-ruler\"><span>18 COLUMNS</span><span>14 ROWS</span></div><canvas data-detail-grid role=\"img\" aria-label=\"An ordered dot matrix with a concentrated region of larger illuminated dots\"></canvas><figcaption>PRESSURE FIELD / DENSITY STUDY</figcaption></figure>\r\n   <div class=\"rd-study-controls\"><label>Pressure <output data-grid-pressure>0.75</output><input type=\"range\" min=\"0.25\" max=\"1.4\" step=\"0.05\" value=\"0.75\" data-grid-control aria-label=\"Grid pressure\"></label></div>\r\n   <section class=\"rd-method\"><span class=\"rh-eyebrow\">INSIDE THE EXPERIMENT</span><h2>How order becomes a signal</h2><p>The grid stays regular. Distance from a focal point determines which dots become larger and brighter. Increasing pressure expands the active region, making a local disturbance visible inside the larger system.</p><div class=\"rd-method-sequence\"><span>Regular spacing</span><span>Distance from a point</span><span>Visible interference</span></div></section>\r\n  </main>\r\n  <main class=\"rd-view rd-dungeon rd-dungeon-live\" data-detail=\"dungeon\" hidden>\r\n <section class=\"dg-hero\">\r\n  <div class=\"dg-hero-copy\"><span class=\"dg-eyebrow\">005 / OPEN EXPERIMENT / WORLD MODELS</span><h1>Dry Run<br><span>Dungeon.</span></h1><p>24 possible futures.<br>One real move.</p><div class=\"dg-hero-links\"><button type=\"button\" data-dg-start>Enter the live experiment <span aria-hidden=\"true\">↘</span></button><a href=\"#dg-method\" data-dg-scroll>How it works ↓</a></div></div>\r\n  <figure class=\"dg-hero-capture\"><img src=\"/portfolio/case-assets/dungeon-planning-capture.webp\" width=\"897\" height=\"317\" alt=\"Actual Dry Run Dungeon: cyan shows the committed move; violet shows candidate paths predicted by the learned model\"><figcaption><span>ACTUAL PLANNING CAPTURE</span><span>ENGINE <i aria-hidden=\"true\">/</i> MODEL</span></figcaption><p>The left side happens.<br>The right side might.</p></figure>\r\n  <div class=\"dg-hero-foot\"><span>BUILT TO SHOW WHERE PREDICTIONS BREAK</span><p>A small dungeon. Three neural nets. A visible gap between prediction and reality.</p></div>\r\n </section>\r\n <section id=\"dg-live\" class=\"dg-live\" aria-label=\"Live Dry Run Dungeon\" hidden>\r\n  <div class=\"dg-live-bar\"><span class=\"dg-eyebrow\">OPEN EXPERIMENT</span><span data-dg-status role=\"status\">Preparing the model…</span><button type=\"button\" data-dg-fullscreen>Full screen ↗</button><a href=\"/experiments/dry-run-dungeon/runtime/index.html?weights=ref-2000-p3\" target=\"_blank\" rel=\"noopener noreferrer\">Open on its own ↗</a></div>\r\n  <p class=\"dg-loading\" data-dg-loading>Loading the browser experiment…</p>\r\n  <iframe data-dungeon-frame title=\"Dry Run Dungeon — live engine, learned model and controls\" scrolling=\"no\" allow=\"fullscreen\" allowfullscreen></iframe>\r\n  <div class=\"dg-session-note\"><span>Use the move buttons or arrow keys to take over.</span><span>Leaving this page ends the live session.</span></div>\r\n </section>\r\n <section class=\"dg-observations\" aria-labelledby=\"dg-observations-title\">\r\n  <div class=\"dg-section-line\"><span class=\"dg-eyebrow\">WHAT TO TRY</span><h2 id=\"dg-observations-title\">Change one thing.<br>Watch what follows.</h2></div>\r\n  <div class=\"dg-tests\">\r\n   <button type=\"button\" data-dg-observe=\"model-toggle\" aria-pressed=\"false\"><span class=\"dg-test-number\">01 <i aria-hidden=\"true\">↗</i></span><h3>Take imagination away.</h3><p>Turn off the world model and restart the same seed. Compare planning with the agent’s greedy, one-step behavior.</p><span class=\"dg-control-label\">CONTROL / WORLD MODEL</span></button>\r\n   <button type=\"button\" data-dg-observe=\"horizon\" aria-pressed=\"false\"><span class=\"dg-test-number\">02 <i aria-hidden=\"true\">↗</i></span><h3>Look too far ahead.</h3><p>Try a horizon of 3, then 25. Watch the predicted paths dissolve as the model feeds guesses back into itself.</p><span class=\"dg-control-label\">CONTROL / HORIZON</span></button>\r\n   <button type=\"button\" data-dg-observe=\"novelty\" aria-pressed=\"false\"><span class=\"dg-test-number\">03 <i aria-hidden=\"true\">↗</i></span><h3>Change the world.</h3><p>Drop a teleporter. Watch predictions near it turn warm, then take over and walk onto a pad to give the model new experience.</p><span class=\"dg-control-label\">CONTROL / DROP A TELEPORTER</span></button>\r\n  </div>\r\n  <p class=\"dg-guide-note\" data-dg-guide-note>Choose a test to open its corresponding control.</p>\r\n </section>\r\n <section id=\"dg-method\" class=\"dg-method\" aria-labelledby=\"dg-method-title\">\r\n  <div class=\"dg-method-heading\"><span class=\"dg-eyebrow\">HOW IT WORKS</span><h2 id=\"dg-method-title\">The rules are written.<br><em>The predictions<br>are learned.</em></h2><p>The engine runs the dungeon’s real rules. A separate ensemble of three small neural networks predicts what a move will do. The planner uses those predictions to try possible futures.</p></div>\r\n  <ol class=\"dg-loop\"><li><span>01 / OBSERVE</span><h3>Start from the real state.</h3><p>The current board becomes the starting point for each set of dry runs.</p></li><li><span>02 / IMAGINE</span><h3>Try 24 futures.</h3><p>The model predicts sequences of moves. The planner scores the parts that remain within its trust line.</p></li><li><span>03 / COMMIT</span><h3>Take one real step.</h3><p>Only the first move of the chosen sequence reaches the game engine. Then the agent plans again.</p></li><li><span>04 / LEARN</span><h3>Compare with what happened.</h3><p>The actual transition becomes training data. Prediction error stays visible as the model learns from play.</p></li></ol>\r\n  <aside class=\"dg-boundary\"><span>THE BOUNDARY IS THE POINT</span><p>The planner’s imagined futures come from the learned model. It cannot call the game engine to look up what will happen.</p></aside>\r\n </section>\r\n <section class=\"dg-reading\" aria-labelledby=\"dg-reading-title\"><div><span class=\"dg-eyebrow\">READING THE PICTURE</span><h2 id=\"dg-reading-title\">The fading is<br>part of the story.</h2><p>Uncertainty is the model’s own disagreement about a prediction. Error is the comparison with a result after a real move. Watch both.</p></div><dl><div><dt><span class=\"dg-sample dg-solid\" aria-hidden=\"true\"></span>Solid path</dt><dd>The chosen dry run.</dd></div><div><dt><span class=\"dg-sample dg-dashed\" aria-hidden=\"true\"></span>Dashed paths</dt><dd>The other candidate futures.</dd></div><div><dt><span class=\"dg-sample dg-dots\" aria-hidden=\"true\"></span>Scattered dots</dt><dd>Predictions beyond the trust line.</dd></div><div><dt><span class=\"dg-sample dg-warm\" aria-hidden=\"true\"></span>Warm paths / ?</dt><dd>Unfamiliar terrain near the dropped pads.</dd></div></dl></section>\r\n <section class=\"dg-findings\" aria-labelledby=\"dg-findings-title\"><div class=\"dg-findings-heading\"><span class=\"dg-eyebrow\">WHAT THE RECORDED TEST SHOWED</span><h2 id=\"dg-findings-title\">More cautious.<br><em>Less efficient.</em></h2><p>Planning produced fewer deaths in this test, but used more steps and finished fewer runs.</p></div><div><table><caption>DEVELOPMENT BENCHMARK / NOT THE LIVE SESSION</caption><thead><tr><th scope=\"col\">Measure</th><th scope=\"col\">Planning</th><th scope=\"col\">Reactive</th></tr></thead><tbody><tr><th scope=\"row\">Deaths</th><td>5</td><td>27</td></tr><tr><th scope=\"row\">Mean steps</th><td>110</td><td>92</td></tr><tr><th scope=\"row\">Wins</th><td>5 / 30</td><td>10 / 30</td></tr></tbody></table><p class=\"dg-benchmark-note\">Recorded P3 measurement: 10 seeds × 3 random streams, 120 real steps per seed-run, horizon 12 and 24 candidate sequences. Mean steps include runs that reached the 120-step cap. These are development measurements, not a promise about every run.</p></div></section>\r\n <section class=\"dg-colophon\"><p>Training and prediction run in your browser. The live study starts from an existing trained reference model and continues learning from real moves.</p><div><span>WORLD MODEL / 3 SMALL NEURAL NETWORKS</span><span>DESIGN + BUILD / JOSH COLE</span></div></section>\r\n <span hidden data-dungeon-signature=\"data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%2232%2061%20685%20378%22%20role%3D%22img%22%20aria-labelledby%3D%22signature-title%20signature-desc%22%3E%0A%3Ctitle%20id%3D%22signature-title%22%3EJosh%20Cole%20signature%3C%2Ftitle%3E%0A%3Cdesc%20id%3D%22signature-desc%22%3EVector%20outline%20traced%20from%20Josh%20Cole's%20original%20handwritten%20signature.%20Irregular%20stroke%20edges%20retained.%3C%2Fdesc%3E%0A%3Cmetadata%3EDerived%20from%20josh-cole-art-logo.png%3B%20SHA256%2079df3f9bac1896a3d01003663dda481c6fb0a288c4a47e22bb28b6b6d937916d.%20Alpha%20contour%20127.5%3B%20simplification%20tolerance%200.16%20source%20pixels.%20Gradient%20reconstructed%20from%20source%20colours.%3C%2Fmetadata%3E%0A%3Cpath%20fill%3D%22%2326c5ff%22%20fill-rule%3D%22evenodd%22%20d%3D%22M404.5%2066.44L403.1%2067.5L401.37%2070.5L401.2%2071.5L401.37%2081.5L404.02%2097.5L404.78%20100.5L405.15%20103.5L405.58%20104.5L405.37%20105.5L405.69%20106.5L406.15%20112.5L407.84%20118.5L408.24%20124.5L408.78%20126.5L409.17%20130.5L409.71%20131.5L410.06%20137.5L410.47%20138.5L411.24%20143.5L411.9%20144.5L411.98%20147.5L412.9%20150.5L414.24%20158.5L414.92%20160.5L415.38%20163.5L416.1%20164.5L416.01%20166.5L416.3%20167.5L420.06%20176.5L420.99%20177.5L421.11%20178.5L422.77%20180.5L423.3%20181.5L425.5%20183.85L428.5%20186.7L430.5%20187.7L432.5%20187.89L436.5%20186.78L440.77%20182.5L442.14%20179.5L442.9%20178.5L443.7%20175.5L444.3%20174.5L444.84%20172.5L446.14%20166.5L448.5%20160.66L449.11%20159.5L451.5%20156.51L454.5%20155.98L456.5%20156.23L460.5%20157.3L464.5%20158.89L466.5%20159.18L474.5%20163.96L476.5%20164.94L477.5%20165.14L479.5%20166.77L493.5%20173.23L497.5%20175.83L498.5%20175.99L501.5%20177.64L505.5%20179.07L508.5%20180.75L513.5%20182.95L516.5%20183.76L517.5%20184.42L518.5%20184.53L520.5%20185.31L521.5%20185.97L522.5%20186.31L523.5%20186.31L524.5%20186.9L528.5%20188.23L530.5%20188.42L532.5%20189.31L537.5%20190.64L539.5%20190.9L540.5%20191.19L541.5%20191.94L544.5%20192.21L550.5%20193.78L552.5%20194.03L555.5%20194.94L561.5%20195.12L562.5%20194.16L562.95%20194.5L562.5%20195.53L565.5%20196.04L567.5%20195.73L569.5%20196.66L571.5%20196.51L574.5%20196.98L581.5%20197.12L582.5%20197.96L584.5