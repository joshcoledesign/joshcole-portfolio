dth\":1600,\"height\":900},\"bark\":{\"title\":\"The bark\",\"caption\":\"Willow tree bark beside the pattern abstracted from it\",\"src\":\"/portfolio/case-assets/willow-willow-pattern.webp\",\"width\":1600,\"height\":814},\"box\":{\"title\":\"The box\",\"caption\":\"Two shipping boxes in white with the willow bed wordmark and the bark pattern\",\"src\":\"/portfolio/case-assets/willow-willow-box.webp\",\"width\":1600,\"height\":1026}}</script></div></section><article class=\"xc-story\"><section id=\"willow-introduction\" class=\"xc-chapter xc-chapter-0\"><span class=\"xc-chapter-index\" aria-hidden=\"true\">01 / WILLOW</span><h2>The brief</h2><p style=\"grid-row:2\" data-extended-source=\"willow-source-1\">Willow was a new bed-in-a-box mattress brand. They made the bed. We built the look and the brand strategy.</p><p style=\"grid-row:3\" data-extended-source=\"willow-source-2\">The identity came from the tree it's named after, down to the bark on the box. We kept it quiet on purpose, in a category that mostly shouts. That was the team's call, after a lot of brainstorming.</p><p style=\"grid-row:4\" data-extended-source=\"willow-source-3\">I was creative director on it at ST8MNT. Parker Foote designed it, and Aaron Rayburn art-directed. The sketch sheets are Parker's, and they're here because the mark didn't arrive in one pass.</p></section></article><section class=\"ns-evidence xc-pad\"><div class=\"xc-section-heading\"><span class=\"xc-eyebrow\">THE FINISHED IDENTITY / AND THE WORK BEHIND IT</span><h2>Room<br><em>to rest.</em></h2></div><figure class=\"xc-media\"><img src=\"/portfolio/case-assets/willow-willow-box.webp\" width=\"1600\" height=\"1026\" loading=\"lazy\" alt=\"Two shipping boxes in white with the willow bed wordmark and the bark pattern\"><figcaption><span data-extended-source=\"willow-source-4\">Two shipping boxes in white with the willow bed wordmark and the bark pattern</span><button type=\"button\" data-xc-inspect=\"/portfolio/case-assets/willow-willow-box.webp\" data-xc-caption=\"Two shipping boxes in white with the willow bed wordmark and the bark pattern\" class=\"cursor-interaction\">Inspect the work ↗</button></figcaption></figure><figure class=\"xc-media\"><img src=\"/portfolio/case-assets/willow-willow-mark.webp\" width=\"1600\" height=\"900\" loading=\"lazy\" alt=\"Willow's geometric tree mark and lowercase willow bed wordmark in black on white\"><figcaption><span data-extended-source=\"willow-source-5\">Willow's geometric tree mark and lowercase willow bed wordmark in black on white</span><button type=\"button\" data-xc-inspect=\"/portfolio/case-assets/willow-willow-mark.webp\" data-xc-caption=\"Willow's geometric tree mark and lowercase willow bed wordmark in black on white\" class=\"cursor-interaction\">Inspect the work ↗</button></figcaption></figure><figure class=\"xc-media\"><img src=\"/portfolio/case-assets/willow-willow-sketches.webp\" width=\"1600\" height=\"900\" loading=\"lazy\" alt=\"Pencil sketch sheets exploring the willow mark\"><figcaption><span data-extended-source=\"willow-source-6\">Pencil sketch sheets exploring the willow mark</span><button type=\"button\" data-xc-inspect=\"/portfolio/case-assets/willow-willow-sketches.webp\" data-xc-caption=\"Pencil sketch sheets exploring the willow mark\" class=\"cursor-interaction\">Inspect the work ↗</button></figcaption></figure><figure class=\"xc-media\"><img src=\"/portfolio/case-assets/willow-willow-pattern.webp\" width=\"1600\" height=\"814\" loading=\"lazy\" alt=\"Willow tree bark beside the pattern abstracted from it\"><figcaption><span data-extended-source=\"willow-source-7\">Willow tree bark beside the pattern abstracted from it</span><button type=\"button\" data-xc-inspect=\"/portfolio/case-assets/willow-willow-pattern.webp\" data-xc-caption=\"Willow tree bark beside the pattern abstracted from it\" class=\"cursor-interaction\">Inspect the work ↗</button></figcaption></figure><figure class=\"xc-media\"><img src=\"/portfolio/case-a